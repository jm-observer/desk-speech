{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "non-streaming-speech-recognition-from-microphone",
  "version": "1.13.0",
  "identifier": "com.k2fsa.sherpa.onnx.asr.microphone",
  "build": {
    "beforeDevCommand": "npm run dev --prefix src",
    "beforeBuildCommand": "npm run build --prefix src",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StreamSpeech",
        "decorations": true,
        "transparent": false,
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["assets"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
