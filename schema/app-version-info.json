{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppVersionInfo",
  "description": "前后端共享的应用版本信息结构",
  "type": "object",
  "required": ["app_version", "app_name", "build_profile", "schema_version", "first_run_after_upgrade"],
  "properties": {
    "app_version": {
      "type": "string",
      "description": "应用发行版本，SemVer 风格字符串"
    },
    "app_name": {
      "type": "string",
      "description": "应用显示名称"
    },
    "build_profile": {
      "type": "string",
      "description": "构建配置标识"
    },
    "git_commit": {
      "type": ["string", "null"],
      "description": "构建时的 Git commit hash"
    },
    "schema_version": {
      "type": "integer",
      "description": "数据库 schema 版本"
    },
    "config_schema_version": {
      "type": "integer",
      "description": "配置对象结构版本"
    },
    "first_run_after_upgrade": {
      "type": "boolean",
      "description": "是否为升级后首次运行"
    }
  }
}
